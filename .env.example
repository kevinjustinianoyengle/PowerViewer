# PowerViewer configuration template.
# Copy this file to ".env" and adjust as needed:  cp .env.example .env
# The real ".env" is git-ignored so local settings never reach the repo.

# Host / port the Dash server binds to.
POWERVIEWER_HOST=127.0.0.1
POWERVIEWER_PORT=8050

# Dash debug mode + hot-reload ("true"/"false"). Turn OFF for production.
POWERVIEWER_DEBUG=true

# Optional: override where data is read from and screenshots are written.
# Leave blank to use the defaults ("1. Data" and "2. Screenshots" next to app.py).
# POWERVIEWER_DATA_DIR=
# POWERVIEWER_SCREENSHOT_DIR=
